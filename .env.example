# Konfigurasi web app dari Firebase Console → Project settings → Your apps (Web).
# Nilai-nilai ini memang publik (dikirim ke browser); pengamanan ada di
# firestore.rules + requireAdmin, bukan di kerahasiaan key ini.
NUXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA9QWpS5lWEHB-RTSNC1oafoqScD2YfUpE
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=laskarnolderajat-6693f.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=laskarnolderajat-6693f
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=laskarnolderajat-6693f.firebasestorage.app
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=278093164285
NUXT_PUBLIC_FIREBASE_APP_ID=1:278093164285:web:6178082eb101303c5b9894
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-514LYJ582Q

# false = menyambung ke Firebase asli. Set true kalau mau pakai Emulator Suite
# (jalankan `npm run emu` dulu) supaya percobaan tidak menyentuh data produksi.
NUXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# --- Kredensial server (firebase-admin) ---
# HANYA untuk dev lokal. Di Firebase App Hosting jangan diisi: runtime-nya sudah
# menyediakan Application Default Credentials sendiri.
# Ambil dari Project settings → Service accounts → Generate new private key,
# simpan sebagai serviceAccount.json di root project (sudah masuk .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Alternatif kalau platform hosting hanya bisa env var (isi JSON-nya satu baris).
NUXT_FIREBASE_SERVICE_ACCOUNT=

# Dipakai scripts/seed.ts dan Emulator Suite.
FIREBASE_PROJECT_ID=laskarnolderajat-6693f
